# Base HTTP de la Aggregator API (carpeta ../api). El servidor de esta app
# llama a la API desde el backend; nunca se expone al navegador.
STATS_API_BASE_URL=http://localhost:3000

# Clave de Google AI Studio / Gemini. Solo se usa en el servidor.
# Crear en https://aistudio.google.com/apikey y pegar en .env.local.
GEMINI_API_KEY=

# Modelo de Gemini para el reporte cualitativo.
GEMINI_MODEL=gemini-3.6-flash

# Base de la API de Gemini (opcional; por defecto v1 de Google AI Studio).
# GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1

# --- Supabase · ciclo de aprendizaje (SOLO SERVIDOR) -------------------------
# Estas variables nunca llevan prefijo NEXT_PUBLIC: la clave de servicio salta
# RLS y no debe llegar al navegador. Rellenar en .env.local, no aquí.

# URL del proyecto, p. ej. https://<project-ref>.supabase.co
SUPABASE_URL=

# Clave service_role del proyecto. Permite escribir en matches, snapshots,
# predicciones y eventos; sin ella la persistencia queda desactivada.
SUPABASE_SERVICE_ROLE_KEY=

# Interruptor maestro. "false" desactiva toda escritura y toda lectura remota
# del laboratorio sin tocar las credenciales (por defecto: activada).
SUPABASE_PERSISTENCE_ENABLED=true

# Tiempo máximo por petición a PostgREST en milisegundos (250–10000).
SUPABASE_TIMEOUT_MS=1200

# --- Ingesta post-partido (SOLO SERVIDOR) ------------------------------------
# Token esperado en la cabecera x-ingest-token de POST /api/ingest/post.
# Sin él, en producción la ruta responde 503 INGEST_DISABLED.
INGEST_TOKEN=
